# ============================================
# Copiloto Financiero RAG - Variables de Entorno
# ============================================

# Groq API Key (obligatorio)
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# Modelo LLM de Groq
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# Proveedor de Embeddings
# ============================================
# Opciones disponibles:
# - 'huggingface' (local, consume 300-400MB RAM - NO funciona en Render Free)
# - 'google'      (API, GRATIS - obtén key en ai.google.dev)
# - 'mistral'     (API, tier gratuito - obtén key en console.mistral.ai)
#
# Para Render Free (512MB RAM): usar 'google' o 'mistral'
EMBEDDING_PROVIDER=huggingface

# --- Google Generative AI (GRATIS) ---
# Obtener API Key gratis en: https://ai.google.dev/
# No requiere tarjeta de crédito para empezar
GOOGLE_API_KEY=tu_google_api_key_aqui
GOOGLE_EMBEDDING_MODEL=models/embedding-001

# --- Mistral AI (tier gratuito) ---
# Obtener API Key en: https://console.mistral.ai/
# Tier gratuito disponible
MISTRAL_API_KEY=tu_mistral_api_key_aqui
MISTRAL_EMBEDDING_MODEL=mistral-embed

# --- HuggingFace (local - solo si tienes suficiente RAM) ---
# Se descarga automáticamente, gratis pero consume 300-400MB RAM
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================
# Configuración ChromaDB
# ============================================
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=financial_docs

# ============================================
# Configuración del servidor
# ============================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# ============================================
# Configuración RAG
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVED_DOCS=5
