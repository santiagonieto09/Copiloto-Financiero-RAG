# ============================================
# Copiloto Financiero RAG - Variables de Entorno
# ============================================

# Groq API Key (obligatorio)
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# Modelo LLM de Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Modelo de embeddings (HuggingFace - gratuito, se descarga localmente)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Configuración ChromaDB
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=financial_docs

# Configuración del servidor
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# Configuración RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_RETRIEVED_DOCS=5
